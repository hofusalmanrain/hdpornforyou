# Bare-metal server env (used when running `node src/index.js` outside Docker).
PORT=3001
STATIC_DIR=../dist
SESSION_SECRET=replace-me-use-openssl-rand-hex-32
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=hdpornforyou
PGPASSWORD=replace-me
PGDATABASE=hdpornforyou
PG_POOL_MAX=20
PG_POOL_MIN=2
PG_STATEMENT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
BATCH_FLUSH_MS=30000
CACHE_MAX_KEYS=5000

# ---- Session cookie ----
# Set to 1 when serving over HTTPS (cookie flagged Secure — browser requires HTTPS).
# Leave as 0 for local dev or plain-HTTP, otherwise the browser drops the session cookie.
COOKIE_SECURE=0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Optional: connect to a single DATABASE_URL instead of individual PG vars ----
# DATABASE_URL=postgresql://hdpornforyou:password@127.0.0.1:5432/hdpornforyou

# ---- Optional: SSL for remote databases ----
# PGSSLMODE=require

# ---- SEO ----
# Crawler-only HTML shell (normal browsers always get the React SPA).
SEO_SHELL_ENABLED=true
SEO_SHELL_BOTS_ONLY=true
# Tags with fewer videos are noindexed and omitted from sitemaps.
TAG_MIN_VIDEOS=2
# Canonical origin used by server-rendered heads and the crawler shell.
SEO_CANONICAL_BASE=https://hdpornforyou.com
# SEO_SHELL_DEBUG=0
